page{background:#f5f5f5;color:#191919;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif}.page{padding-bottom:32rpx}.section{background:#fff;margin-top:20rpx}.section-title{font-size:34rpx;font-weight:600;padding:28rpx 32rpx 18rpx}.muted{color:#888;font-size:25rpx;line-height:1.55}.row{background:#fff;padding:28rpx 32rpx;border-bottom:1rpx solid #ededed}.row-title{font-size:31rpx;font-weight:600;margin:8rpx 0}.tag{display:inline-block;background:#f2f2f2;color:#666;padding:5rpx 12rpx;border-radius:6rpx;font-size:21rpx;margin-right:8rpx}.tag-green{background:#edf8f1;color:#159957}.button{background:#07c160;color:#fff;border-radius:10rpx;margin:20rpx 0 0;font-size:26rpx;line-height:68rpx}.button-secondary{background:#f1f1f1;color:#444}.notice{margin:20rpx 28rpx;padding:20rpx 22rpx;background:#fff8e7;color:#796024;border-radius:10rpx;font-size:23rpx;line-height:1.55}.notice-safe{background:#eef8f2;color:#397154}.empty{text-align:center;color:#999;padding:80rpx 24rpx;font-size:25rpx}.input,.textarea{width:100%;box-sizing:border-box;background:#f5f5f5;border-radius:10rpx;padding:18rpx 20rpx;font-size:27rpx}.textarea{min-height:180rpx}.split{display:flex;align-items:center;justify-content:space-between}.text-button{color:#159957;font-size:25rpx}.menu-row{height:102rpx;padding:0 32rpx;background:#fff;border-bottom:1rpx solid #ededed;display:flex;align-items:center;justify-content:space-between;font-size:29rpx}.badge{background:#ee5146;color:#fff;border-radius:30rpx;padding:2rpx 12rpx;font-size:20rpx}
