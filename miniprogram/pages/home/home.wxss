@import "../../member-theme.wxss";

.search{margin:18rpx 28rpx 0;height:70rpx;background:#fff;border-radius:12rpx;padding:0 20rpx;display:flex;align-items:center;color:#999}.search input{flex:1;margin-left:12rpx;font-size:26rpx}.timeline{background:#fff}.feed-row{display:flex;gap:20rpx;padding:28rpx 30rpx;border-bottom:1rpx solid #ededed}.feed-mark{width:78rpx;height:78rpx;border-radius:12rpx;background:#edf8f1;color:#159957;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:600}.feed-main{flex:1}.feed-actions{display:flex;align-items:center;gap:18rpx;margin-top:14rpx}.favorite{font-size:42rpx;color:#999}.favorite.saved{color:#efa32c}
.feed-main{min-width:0}.clamp-title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;word-break:break-word;line-height:1.45;max-height:2.9em}
