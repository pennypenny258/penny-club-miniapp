<view class="page" wx:if="{{me}}"><member-brand/><view class="profile"><view class="avatar">{{me.avatarInitial}}</view><view><view class="name">{{me.nickname}}</view><view class="muted">{{me.identityNotice}}</view></view></view><view class="membership"><view><text class="membership-value">{{me.isActive?'会籍有效':'会籍待核验'}}</text><text class="muted">截止 {{me.endsAt}}</text></view><view><text class="membership-value">{{me.membershipRole}}</text><text class="muted">演示身份标签</text></view><button bindtap="renew">续费</button></view><view class="notice notice-safe">正式环境使用微信联合登录；当前未读取微信头像或昵称，也未执行真实支付。</view><view class="menu"><view class="menu-row" data-key="internal" bindtap="toggle"><text>内部资料</text><text class="muted">永不公开 ›</text></view><view class="panel" wx:if="{{open==='internal'}}"><view>机构：{{internal.organization||'待完善'}}</view><view>城市：{{internal.city||'待完善'}}</view><view>手机号：{{internal.phoneMasked}}</view><view class="muted">内部资料不会自动同步至公开名册。</view></view><view class="menu-row" bindtap="openPublicProfile"><text>我的公开名册</text><text class="muted">提交后人工审核 ›</text></view><view class="menu-row" bindtap="openEmployment"><text>在职名片核验</text><text class="muted">只进入内部 CRM ›</text></view><view class="menu-row" data-key="notice" bindtap="toggle"><text>需求通知 / 对接申请</text><text class="badge" wx:if="{{notifications.length}}">{{notifications.length}}</text><text wx:else class="muted">暂无 ›</text></view><view class="panel" wx:if="{{open==='notice'}}"><view class="connection" wx:for="{{notifications}}" wx:key="id"><view class="row-title">{{item.requesterDisplayName}}的对接申请</view><view class="muted">{{item.reason}}</view><view class="muted">联系方式未披露</view><view wx:if="{{item.status==='submitted'}}" class="decisions"><button data-id="{{item.id}}" data-decision="share_contact" bindtap="decide">同意受控介绍</button><button data-id="{{item.id}}" data-decision="decline" bindtap="decide">拒绝</button><button data-id="{{item.id}}" data-decision="continue_agent" bindtap="decide">让 Agent 继续</button></view></view></view><view class="menu-row" data-key="favorites" bindtap="toggle"><text>我的收藏</text><text class="muted">{{favorites.length}} 条 ›</text></view><view class="panel" wx:if="{{open==='favorites'}}"><view class="favorite-row" wx:for="{{favorites}}" wx:key="targetId">{{item.title}}</view></view></view><button class="logout" bindtap="logout">退出登录（演示）</button></view>
