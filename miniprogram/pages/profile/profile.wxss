@import "../../member-theme.wxss";

.profile{display:flex;align-items:center;gap:24rpx;background:#fff;padding:34rpx 32rpx}.avatar{width:104rpx;height:104rpx;border-radius:16rpx;background:#dfe4e2;color:#52605b;font-size:42rpx;font-weight:600;display:flex;align-items:center;justify-content:center}.name{font-size:35rpx;font-weight:600}.membership{display:grid;grid-template-columns:1fr 1fr 124rpx;gap:18rpx;background:#fff;border-top:1rpx solid #ededed;padding:24rpx 32rpx}.membership-value,.membership .muted{display:block}.membership-value{font-size:26rpx;font-weight:600}.membership button{margin:0;background:#edf8f1;color:#159957;font-size:24rpx;line-height:62rpx;border-radius:10rpx}.menu{margin-top:20rpx}.panel{padding:24rpx 32rpx;background:#fff;border-bottom:1rpx solid #ededed;font-size:26rpx;line-height:1.8}.connection{padding:14rpx 0;border-bottom:1rpx solid #ededed}.decisions button{display:inline-block;width:auto;margin:16rpx 10rpx 0 0;padding:0 18rpx;font-size:22rpx;line-height:58rpx;background:#f1f1f1}.favorite-row{padding:12rpx 0;border-bottom:1rpx solid #ededed}.logout{margin:30rpx 0 0;background:#fff;color:#d64a3a;border-radius:0;font-size:27rpx}
