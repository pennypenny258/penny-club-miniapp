<view class="page"><view class="hero"><view class="hero-title">我的公开名册</view><view>自主维护 · 审核后发布</view></view><view class="notice">请勿填写手机、微信、邮箱或地址；联系方式统一通过申请对接。</view><view class="card"><view class="field"><text>公开显示名</text><input value="{{form.public_display_name}}" data-field="public_display_name" bindinput="input"/></view><view class="field"><text>公开机构</text><input value="{{form.organization}}" data-field="organization" bindinput="input"/></view><view class="field"><text>公开职位</text><input value="{{form.title}}" data-field="title" bindinput="input"/></view><view class="field"><text>城市</text><input value="{{form.city}}" data-field="city" bindinput="input"/></view><view class="field"><text>行业 / 赛道（逗号分隔）</text><input value="{{form.industry_tracks}}" data-field="industry_tracks" bindinput="input"/></view><view class="field"><text>兴趣方向</text><input value="{{form.interests}}" data-field="interests" bindinput="input"/></view><view class="field"><text>阶段</text><input value="{{form.investment_stages}}" data-field="investment_stages" bindinput="input"/></view><view class="field"><text>专业领域</text><input value="{{form.expertise}}" data-field="expertise" bindinput="input"/></view><view class="field"><text>简介</text><textarea value="{{form.bio}}" data-field="bio" bindinput="input"/></view><view class="field"><text>合作偏好</text><input value="{{form.collaboration_preferences}}" data-field="collaboration_preferences" bindinput="input"/></view><view class="field switch"><text>审核通过后公开可见</text><switch checked="{{visible}}" bindchange="visibility" color="#176b4b"/></view><button class="button" bindtap="submit">提交审核</button></view><view class="card"><view class="card-title">更新记录</view><view class="status" wx:for="{{updates}}" wx:key="id"><text>{{item.status}}</text><text class="muted">{{item.submittedAt}}</text></view><view class="muted" wx:if="{{!updates.length}}">尚无更新记录</view></view></view>
