<view class="page"><view class="hero"><view class="hero-title">活动中心</view><view>线上 · 线下 · 混合</view></view><view class="notice">线上报名只代表登记和接收通知，不保证腾讯会议席位。</view><view class="card" wx:for="{{items}}" wx:key="id"><view class="pill">{{item.format}}</view><view class="card-title" style="margin-top:12rpx">{{item.title}}</view><view class="muted">开始：{{item.startsAt}}</view><button class="button" wx:if="{{!item.registered}}" data-id="{{item.id}}" bindtap="register">报名</button><button class="button" wx:else data-id="{{item.id}}" bindtap="link">查看会议链接</button></view></view>
