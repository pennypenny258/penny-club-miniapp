@import "../../member-theme.wxss";

.shared-search{margin:18rpx 28rpx;height:70rpx;background:#fff;border-radius:12rpx;padding:0 20rpx;display:flex;align-items:center;color:#999}.shared-search input{flex:1;margin-left:12rpx;font-size:26rpx}.activity-list{padding:0 24rpx 24rpx}.activity-card{background:#fff;border-radius:14rpx;padding:28rpx;margin-bottom:18rpx}.activity-tags{margin-bottom:14rpx}.activity-info{margin-top:18rpx;color:#555;font-size:25rpx;line-height:1.8}.info-label{display:inline-block;width:100rpx;color:#999}.activity-actions{display:flex;gap:14rpx;margin-top:20rpx}.activity-actions .button{margin:0;flex:1}.activity-hint{font-size:22rpx;color:#8a8a8a;margin-top:16rpx}.clamp-title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;word-break:break-word;line-height:1.45;max-height:2.9em}
