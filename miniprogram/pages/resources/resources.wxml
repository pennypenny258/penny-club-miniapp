<view class="page"><member-brand/><view class="shared-search"><text>⌕</text><input value="{{query}}" placeholder="可搜索公开会员名册、活动、资料和需求机会" bindinput="search"/></view><view class="activity-list"><view class="activity-card" wx:for="{{items}}" wx:key="id"><view class="activity-tags"><text class="tag tag-green">{{item.formatLabel}}</text><text class="tag">{{item.statusLabel}}</text></view><view class="row-title clamp-title" aria-label="{{item.title}}">{{item.title}}</view><view class="activity-info"><view><text class="info-label">时间</text>{{item.timeLabel}}</view><view><text class="info-label">{{item.format==='online'?'会议':'地点'}}</text>{{item.locationLabel}}</view><view><text class="info-label">分享者</text>{{item.speakerLabel}}</view><view><text class="info-label">参会者</text>{{item.attendeeLabel}}</view></view><view class="activity-actions" wx:if="{{item.status!=='cancelled'}}"><button wx:if="{{!item.completed&&!item.registered}}" class="button" data-id="{{item.id}}" bindtap="register">报名活动</button><button wx:if="{{!item.completed&&item.format!=='offline'&&item.registered}}" class="button button-secondary" data-id="{{item.id}}" bindtap="meeting">查看会议链接</button><button wx:if="{{item.archiveAvailable}}" class="button" data-id="{{item.id}}" bindtap="archive">查看回放或纪要</button></view><view class="activity-hint" wx:if="{{!item.completed&&item.format!=='offline'&&item.status!=='cancelled'}}">{{item.meetingHint}}</view><view class="activity-hint" wx:if="{{item.completed&&!item.archiveAvailable}}">回放与纪要待整理</view></view></view><view class="empty" wx:if="{{!items.length}}">暂无匹配的活动</view></view>
