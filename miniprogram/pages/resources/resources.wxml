<view class="page"><member-brand/><input class="resource-search" value="{{query}}" placeholder="搜索标题、摘要或标签" bindinput="search"/><scroll-view class="tabs" scroll-x><view class="tab {{active===item.key?'active':''}}" wx:for="{{sections}}" wx:key="key" data-key="{{item.key}}" bindtap="select">{{item.label}}</view></scroll-view><view class="row" wx:for="{{items}}" wx:key="id"><view><text class="tag tag-green">{{item.type}}</text><text class="tag">已审核发布</text></view><view class="row-title">{{item.title}}</view><view class="muted">{{item.summary}}</view><view><text class="tag resource-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" data-tag="{{tag}}" bindtap="selectTag">#{{tag}}</text></view><button class="button" data-id="{{item.id}}" bindtap="view">打开查看</button><button wx:if="{{item.downloadEnabled}}" class="button button-secondary" data-id="{{item.id}}" bindtap="download">下载（需会籍与私有存储校验）</button><view wx:else class="download-off">未开放下载 · 不影响打开查看</view></view><view class="empty" wx:if="{{!items.length}}">该分栏暂无已审核资料</view></view>
