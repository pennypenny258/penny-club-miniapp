<view class="page"><member-brand/><view class="compose"><view class="compose-title">提交你的需求</view><view class="muted">请提供三个必备信息，提交后统一进入人工审核。</view><picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="selectCategory"><view class="textarea">需求类型：{{categories[categoryIndex].label}}</view></picker><input class="textarea" value="{{who}}" maxlength="180" placeholder="我是谁" data-field="who" bindinput="input"/><textarea class="textarea" value="{{background}}" maxlength="300" placeholder="背景" data-field="background" bindinput="input"/><textarea class="textarea" value="{{need}}" maxlength="300" placeholder="具体需求" data-field="need" bindinput="input"/><picker range="{{modes}}" range-key="label" value="{{modeIndex}}" bindchange="selectMode"><view class="textarea">处理方式：{{modes[modeIndex].label}}</view></picker><view class="compose-actions"><view class="voice-entry"><button class="voice-icon" bindtap="record" aria-label="语音输入">{{recording?'■':'🎙'}}</button><text>可语音输入</text></view><button class="submit" bindtap="submit">提交人工审核</button></view><view class="voice-hint">{{voiceNotice}}</view><view class="privacy-hint">公开需求会展示在前台，请自行衡量脱敏程度；私密匹配不会在前台展示，仅供后台受控匹配。</view></view></view>
