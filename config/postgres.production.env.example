# 仅供未来真实生产云托管服务端配置；不要复制到前端，不要提交实际值。
NODE_ENV=production
DATA_REPOSITORY=postgres
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_SCHEMA=venture_private
DATABASE_APP_ROLE=venture_club_app
DATABASE_MIGRATIONS_APPLIED=002_security
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=5000

# DATABASE_URL 必须来自 CloudBase 控制台/服务身份的安全注入，使用最小权限应用角色。
# 云托管运行服务绝不能使用数据库所有者、迁移角色或 CloudBase 管理 API 凭据。
