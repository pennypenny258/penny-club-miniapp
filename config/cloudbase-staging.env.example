# CloudBase 云托管测试环境（penny-club-staging）仅使用以下非敏感配置。
# 请在云托管服务的“环境变量”界面逐项填写，不要上传本机 .env.local。
NODE_ENV=staging
DEPLOYMENT_PROFILE=cloudbase_staging_demo
DEMO_DATA_ONLY=true

# 端口优先在服务设置中填写 3000。服务会读取平台 PORT，未提供时也默认 3000。
PORT=3000

# 暂时不要填写：FEISHU_APP_ID、FEISHU_APP_SECRET、PRIVATE_STORAGE_DIR、DATABASE_URL、
# 微信密钥、支付密钥或任何真实业务系统凭据。
