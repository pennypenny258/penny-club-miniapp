# 仅供未来真实生产云托管服务端配置；当前匿名 staging 不得填写。
NODE_ENV=production
DATA_REPOSITORY=cloudbase_gateway

# 非敏感标识类别：实际环境 ID 只在 CloudBase 服务端环境变量中填写。
CLOUDBASE_PG_ENV_ID=
CLOUDBASE_PG_REGION=ap-shanghai
CLOUDBASE_PG_MIGRATIONS_APPLIED=003_cloudbase_gateway_read_views
CLOUDBASE_PG_CREDENTIAL_PURPOSE=server_runtime

# 当前必须保持 false；真实微信/服务端会员身份映射接通并完成集成测试后才可改为 true。
CLOUDBASE_CATALOG_READS_ENABLED=false
MEMBER_IDENTITY_PROVIDER=

# 敏感值：在 CloudBase 控制台 API 密钥页创建 service_role API Key，
# 只注入云托管服务端环境变量；绝不能写入本文件、前端、小程序、日志或聊天。
CLOUDBASE_PG_SERVER_API_KEY=

# 保守的服务端出站请求限制。
CLOUDBASE_PG_TIMEOUT_MS=5000
CLOUDBASE_PG_MAX_RESPONSE_BYTES=1048576
