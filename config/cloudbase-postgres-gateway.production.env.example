# 仅供未来真实生产云托管服务端配置；当前匿名 staging 不得填写。
NODE_ENV=production
DATA_REPOSITORY=cloudbase_gateway

# 非敏感标识类别：实际环境 ID 只在 CloudBase 服务端环境变量中填写。
CLOUDBASE_PG_ENV_ID=
CLOUDBASE_PG_REGION=ap-shanghai
CLOUDBASE_PG_MIGRATIONS_APPLIED=008_admin_session_rbac
CLOUDBASE_PG_CREDENTIAL_PURPOSE=server_runtime

# 正式运营后台（当前保持 false；只有 008 已人工验证且身份提供方完成后才能启用）
FORMAL_ADMIN_AUTH_ENABLED=false
# ADMIN_AUTH_MODE=external_session
# ADMIN_IDENTITY_PROVIDER=external_verified
# ADMIN_SESSION_STORE=cloudbase_pg
# ADMIN_SESSION_HASH_KEY=
# ADMIN_SUBJECT_HMAC_KEY=
# ADMIN_SESSION_ISSUER=venture-admin
# ADMIN_SESSION_TTL_SECONDS=3600
# ADMIN_STEP_UP_MAX_AGE_SECONDS=300
# ADMIN_GOVERNANCE_ENABLED=false
# ADMIN_BOOTSTRAP_MODE=preprovisioned_subject_hash_once
# ADMIN_ROLE_CHANGE_MODE=two_person
# ADMIN_AUDIT_MODE=redacted_metadata_only

# 当前必须保持 false；真实微信/服务端会员身份映射接通并完成集成测试后才可改为 true。
CLOUDBASE_CATALOG_READS_ENABLED=false
MEMBER_IDENTITY_PROVIDER=

# 当前保持 false。004、受控绑定流程、持久化撤销存储和全链路测试全部完成后才可启用。
WECHAT_LOGIN_ENABLED=false
WECHAT_MINIPROGRAM_APP_ID=
MEMBER_SESSION_ISSUER=
MEMBER_SESSION_AUDIENCE=
MEMBER_SESSION_TTL_SECONDS=900
MEMBER_SESSION_REVOCATION_STORE=

# 敏感值：在 CloudBase 控制台 API 密钥页创建 service_role API Key，
# 只注入云托管服务端环境变量；绝不能写入本文件、前端、小程序、日志或聊天。
CLOUDBASE_PG_SERVER_API_KEY=

# 以下也是服务端 Secret；将来只配置在云托管服务端，绝不写进仓库。
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_IDENTITY_SUBJECT_HMAC_KEY=
MEMBER_SESSION_ENCRYPTION_KEY=

# 私有资料对象存储：005 与私有 bucket 均验证通过后才可配置；当前保持禁用。
PRIVATE_STORAGE_PROVIDER=disabled
CLOUDBASE_STORAGE_ENABLED=false
CLOUDBASE_STORAGE_BUCKET_ID=
CLOUDBASE_STORAGE_BUCKET_PRIVATE_CONFIRMED=false
CLOUDBASE_STORAGE_CREDENTIAL_PURPOSE=
CLOUDBASE_STORAGE_DOWNLOAD_MODE=node_proxy
CLOUDBASE_STORAGE_PREVIEW_MODE=metadata_only
CLOUDBASE_STORAGE_MAX_FILE_BYTES=26214400
CLOUDBASE_STORAGE_TIMEOUT_MS=15000
OBJECT_LOCATOR_ENCRYPTION_KEY=

# CRM / 付款证据 / 自愿公开名册：当前保持禁用。仅在 006、真实后台会话、审计和幂等验收后启用。
GOVERNED_MEMBER_IMPORTS_ENABLED=false
GOVERNED_IMPORT_ADMIN_PROVIDER=
GOVERNED_IMPORT_AUDIT_STORE=
GOVERNED_IMPORT_IDEMPOTENCY_STORE=
GOVERNED_IMPORT_ENCRYPTION_KEY=
MEMBER_MATCH_HMAC_KEY=

# 人工复核后的分域物化：当前保持禁用。必须在 007、职责分离和补偿演练通过后才能启用。
GOVERNED_MATERIALIZATION_ENABLED=false
GOVERNED_MATERIALIZATION_ADMIN_PROVIDER=
GOVERNED_MATERIALIZATION_AUDIT_STORE=
GOVERNED_MATERIALIZATION_IDEMPOTENCY_STORE=

# 保守的服务端出站请求限制。
CLOUDBASE_PG_TIMEOUT_MS=5000
CLOUDBASE_PG_MAX_RESPONSE_BYTES=1048576
